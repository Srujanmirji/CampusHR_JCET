NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://campushr:replace-with-a-local-database-password@localhost:5432/campushr?schema=public
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:5173
# Hosted deployments: private persistent volume, never a public static directory.
# DOCUMENTS_DIR=/data/documents
# Used only by `npm run db:seed` to create the first Super Admin (12–72 bytes).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Optional integrations; configure when their modules are implemented.
STORAGE_URL=
STORAGE_KEY=
REDIS_URL=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
# IOS-010: disabled until the approved Expo project/APNs credentials are ready.
PUSH_ENABLED=false
# EXPO_PROJECT_ID=<approved-project-uuid>
# EXPO_ACCESS_TOKEN=<server-only token when enhanced Expo push security is enabled>

# Email recovery: enable only after configuring and authorizing the Google relay.
PASSWORD_RESET_ENABLED=false
# PASSWORD_RESET_SCRIPT_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
# PASSWORD_RESET_SCRIPT_SECRET=<same private value as CAMPUSHR_MAIL_SECRET>
PASSWORD_RESET_DAILY_LIMIT=80
