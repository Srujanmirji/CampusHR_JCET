generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Authentication & RBAC (features/AUTH.md, backend/DATABASE_SCHEMA.md).

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  description String
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

model User {
  id                    String           @id @default(uuid()) @db.Uuid
  // Stored lowercase; lookups lowercase their input.
  email                 String           @unique
  passwordHash          String           @map("password_hash")
  roleId                Int              @map("role_id")
  role                  Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  // Staff accounts link to their employee record; the Super Admin system
  // account has none.
  employeeId            String?          @unique @map("employee_id") @db.Uuid
  employee              Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  status                UserStatus       @default(ACTIVE)
  lastLoginAt           DateTime?        @map("last_login_at")
  leaveDecisions        LeaveDecision[]
  substitutionsAssigned Substitution[]
  notifications         Notification[]
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  sessions              RefreshSession[]

  @@map("users")
}

// One row per sign-in. Refresh tokens rotate; only their SHA-256 hash is stored.
model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  // false = "Remember me" unticked: the cookie ends with the browser session.
  persistent Boolean   @default(true)
  revokedAt  DateTime? @map("revoked_at")
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")

  @@index([userId])
  @@map("refresh_sessions")
}

// Employees & departments (features/EMPLOYEE_MANAGEMENT.md, DEPARTMENTS.md).

enum StaffCategory {
  TEACHING
  NON_TEACHING

  @@map("staff_category")
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  PROBATIONARY
  VISITING

  @@map("employment_type")
}

enum EmployeeStatus {
  ACTIVE
  ARCHIVED

  @@map("employee_status")
}

model Department {
  id            Int              @id @default(autoincrement())
  // Short code used in employee IDs, e.g. CSE in JCET-CSE-021.
  code          String           @unique
  name          String           @unique
  hodEmployeeId String?          @unique @map("hod_employee_id") @db.Uuid
  hod           Employee?        @relation("DepartmentHod", fields: [hodEmployeeId], references: [id], onDelete: SetNull)
  employees     Employee[]       @relation("DepartmentEmployees")
  subjects      Subject[]
  timetable     TimetableEntry[]
  leaveRequests LeaveRequest[]
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@map("departments")
}

model Designation {
  id        Int                @id @default(autoincrement())
  name      String             @unique
  // Lower is more senior.
  level     Int
  category  StaffCategory
  employees Employee[]
  workload  WorkloadThreshold?

  @@map("designations")
}

model Employee {
  id              String           @id @default(uuid()) @db.Uuid
  // College employee ID, stored uppercase, e.g. JCET-CSE-021.
  employeeCode    String           @unique @map("employee_code")
  firstName       String           @map("first_name")
  lastName        String           @map("last_name")
  // Stored lowercase.
  email           String           @unique
  phone           String?
  departmentId    Int              @map("department_id")
  department      Department       @relation("DepartmentEmployees", fields: [departmentId], references: [id], onDelete: Restrict)
  designationId   Int              @map("designation_id")
  designation     Designation      @relation(fields: [designationId], references: [id], onDelete: Restrict)
  employmentType  EmploymentType   @map("employment_type")
  joiningDate     DateTime         @map("joining_date") @db.Date
  status          EmployeeStatus   @default(ACTIVE)
  qualification   String?
  specialization  String?
  experienceYears Int?             @map("experience_years")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  user            User?
  headOf          Department?      @relation("DepartmentHod")
  timetable       TimetableEntry[]
  leaveRequests   LeaveRequest[]
  substitutions   Substitution[]

  @@index([departmentId])
  @@index([status])
  @@map("employees")
}

// Mandatory for employee and department changes (backend/SECURITY.md).
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  resource    String
  resourceId  String   @map("resource_id")
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([resource, resourceId])
  @@map("audit_logs")
}

// Timetable (features/TIMETABLE.md): fixed periods, Monday to Saturday.

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT

  @@map("weekday")
}

enum SubjectKind {
  THEORY
  LAB

  @@map("subject_kind")
}

enum RoomKind {
  CLASSROOM
  LAB

  @@map("room_kind")
}

model Period {
  // 1 = first period of the day.
  number    Int    @id
  // 24-hour "HH:MM".
  startTime String @map("start_time")
  endTime   String @map("end_time")

  @@map("periods")
}

model Subject {
  id           Int              @id @default(autoincrement())
  // VTU course code, stored uppercase, e.g. BCS501.
  code         String           @unique
  name         String
  departmentId Int              @map("department_id")
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  semester     Int
  kind         SubjectKind
  entries      TimetableEntry[]
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([departmentId, semester])
  @@map("subjects")
}

model Room {
  id      Int              @id @default(autoincrement())
  name    String           @unique
  kind    RoomKind
  entries TimetableEntry[]

  @@map("rooms")
}

// One class: a section (or a lab batch of it) on a day, over one or more
// consecutive periods.
model TimetableEntry {
  id            String         @id @default(uuid()) @db.Uuid
  departmentId  Int            @map("department_id")
  department    Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  semester      Int
  // Class section, e.g. A.
  section       String
  // Lab batch within the section, e.g. A1; null for the whole section.
  batch         String?
  subjectId     Int            @map("subject_id")
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  facultyId     String         @map("faculty_id") @db.Uuid
  faculty       Employee       @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  roomId        Int            @map("room_id")
  room          Room           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  day           Weekday
  startPeriod   Int            @map("start_period")
  endPeriod     Int            @map("end_period")
  substitutions Substitution[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([departmentId, semester, section, day])
  @@index([facultyId, day])
  @@index([roomId, day])
  @@map("timetable_entries")
}

// Faculty workload (features/FACULTY_WORKLOAD.md). Weekly hours are computed
// from timetable entries; only the bands the Principal sets are stored.

// Weekly teaching-hour band for one teaching designation: below minHours is
// underloaded, above maxHours overloaded.
model WorkloadThreshold {
  designationId Int         @id @map("designation_id")
  designation   Designation @relation(fields: [designationId], references: [id], onDelete: Cascade)
  minHours      Int         @map("min_hours")
  maxHours      Int         @map("max_hours")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("workload_thresholds")
}

// Leave (features/LEAVE_MANAGEMENT.md). JCET's types, quotas, half-day and
// carry-over rules are data HR enters; the approval chain is fixed by role.
// Day counts are multiples of 0.5, which a float holds exactly.

model LeaveType {
  id              Int            @id @default(autoincrement())
  // Short code, stored uppercase, e.g. CL.
  code            String         @unique
  name            String         @unique
  // Days per calendar year; null means no limit (e.g. loss of pay).
  yearlyQuota     Float?         @map("yearly_quota")
  allowHalfDay    Boolean        @default(false) @map("allow_half_day")
  // Most unused days that move into the next year; 0 means none.
  carryForwardMax Float          @default(0) @map("carry_forward_max")
  // Retired types stay for history but take no new requests.
  active          Boolean        @default(true)
  requests        LeaveRequest[]
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@map("leave_types")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("leave_status")
}

enum HalfDaySession {
  FIRST
  SECOND

  @@map("half_day_session")
}

model LeaveRequest {
  id            String          @id @default(uuid()) @db.Uuid
  employeeId    String          @map("employee_id") @db.Uuid
  employee      Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  // The applicant's department when they applied; scopes HOD access.
  departmentId  Int             @map("department_id")
  department    Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  leaveTypeId   Int             @map("leave_type_id")
  leaveType     LeaveType       @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  startDate     DateTime        @map("start_date") @db.Date
  endDate       DateTime        @map("end_date") @db.Date
  // Set for a half-day request (one date only).
  halfDay       HalfDaySession? @map("half_day")
  // Working days taken (Sundays excluded).
  days          Float
  reason        String
  status        LeaveStatus     @default(PENDING)
  // Approver roles in order, fixed when the request is made.
  approverRoles String[]        @map("approver_roles")
  // Role that acts next; null once the request is decided or cancelled.
  pendingRole   String?         @map("pending_role")
  decisions     LeaveDecision[]
  substitutions Substitution[]
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([employeeId, startDate])
  @@index([status, pendingRole, departmentId])
  @@map("leave_requests")
}

// One approval or rejection, step by step.
model LeaveDecision {
  id            String       @id @default(uuid()) @db.Uuid
  requestId     String       @map("request_id") @db.Uuid
  request       LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  step          Int
  role          String
  deciderUserId String       @map("decider_user_id") @db.Uuid
  decider       User         @relation(fields: [deciderUserId], references: [id], onDelete: Restrict)
  approved      Boolean
  note          String?
  decidedAt     DateTime     @default(now()) @map("decided_at")

  @@index([requestId])
  @@map("leave_decisions")
}

// Smart substitution (features/SMART_SUBSTITUTION.md): how each class missed
// through approved leave is covered, one row per class and date.

enum CoverageKind {
  // Another faculty member takes the class.
  SUBSTITUTE
  // Handled without a substitute (e.g. supervised self-study); see note.
  NOT_NEEDED

  @@map("coverage_kind")
}

model Substitution {
  id               String         @id @default(uuid()) @db.Uuid
  leaveRequestId   String         @map("leave_request_id") @db.Uuid
  leaveRequest     LeaveRequest   @relation(fields: [leaveRequestId], references: [id], onDelete: Restrict)
  // ponytail: a deleted class takes its coverage with it; keep a snapshot
  // of the class if past coverage must survive timetable changes.
  timetableEntryId String         @map("timetable_entry_id") @db.Uuid
  timetableEntry   TimetableEntry @relation(fields: [timetableEntryId], references: [id], onDelete: Cascade)
  date             DateTime       @db.Date
  kind             CoverageKind
  substituteId     String?        @map("substitute_id") @db.Uuid
  substitute       Employee?      @relation(fields: [substituteId], references: [id], onDelete: Restrict)
  // The arrangement when no substitute is needed.
  note             String?
  assignedByUserId String         @map("assigned_by_user_id") @db.Uuid
  assignedBy       User           @relation(fields: [assignedByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now()) @map("created_at")

  @@unique([timetableEntryId, date])
  @@index([substituteId, date])
  @@index([leaveRequestId])
  @@map("substitutions")
}

// In-app notifications (features/NOTIFICATIONS.md), one row per recipient.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // What happened, e.g. leave.submitted; lets clients pick an icon.
  kind      String
  title     String
  body      String
  // In-app path to open, e.g. /leave?request=…
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}
