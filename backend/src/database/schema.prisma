generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Authentication & RBAC (features/AUTH.md, backend/DATABASE_SCHEMA.md).

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  description String
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

model User {
  id                    String           @id @default(uuid()) @db.Uuid
  // Stored lowercase; lookups lowercase their input.
  email                 String           @unique
  passwordHash          String           @map("password_hash")
  authVersion           Int              @default(0) @map("auth_version")
  roleId                Int              @map("role_id")
  role                  Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  // Staff accounts link to their employee record; the Super Admin system
  // account has none.
  employeeId            String?          @unique @map("employee_id") @db.Uuid
  employee              Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  status                UserStatus       @default(ACTIVE)
  lastLoginAt           DateTime?        @map("last_login_at")
  leaveDecisions        LeaveDecision[]
  substitutionsAssigned Substitution[]
  notifications         Notification[]
  attendanceReviewed    AttendanceCorrection[] @relation("AttendanceReviewed")
  documentsReviewed     Document[]             @relation("DocumentReviewed")
  circularsAuthored     Circular[]             @relation("CircularAuthor")
  circularReceipts      CircularReadReceipt[]
  workAssignedBy        WorkAssignment[]       @relation("WorkAssignedBy")
  issuedAppointmentLetters OnboardingCandidate[] @relation("AppointmentLetterIssuer")
  onDutyHodReviews      OnDutyRequest[]        @relation("OnDutyHodReview")
  onDutyFinalApprovals  OnDutyRequest[]        @relation("OnDutyFinalApproval")
  calendarDaysCreated   CalendarDay[]          @relation("CalendarDayCreatedBy")
  balanceAdjustmentsMade LeaveBalanceAdjustment[] @relation("BalanceAdjuster")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  passwordResets        PasswordResetChallenge[]
  sessions              RefreshSession[]
  pushDevices           PushDevice[]

  @@map("users")
}

// One row per sign-in. Refresh tokens rotate; only their SHA-256 hash is stored.
model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  // false = "Remember me" unticked: the cookie ends with the browser session.
  persistent Boolean   @default(true)
  revokedAt  DateTime? @map("revoked_at")
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")

  pushDevice PushDevice?

  @@index([userId])
  @@map("refresh_sessions")
}

// Employees & departments (features/EMPLOYEE_MANAGEMENT.md, DEPARTMENTS.md).

enum StaffCategory {
  TEACHING
  NON_TEACHING

  @@map("staff_category")
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  PROBATIONARY
  VISITING

  @@map("employment_type")
}

enum EmployeeStatus {
  ACTIVE
  ARCHIVED

  @@map("employee_status")
}

model Department {
  id            Int              @id @default(autoincrement())
  // Short code used in employee IDs, e.g. CSE in JCET-CSE-021.
  code          String           @unique
  name          String           @unique
  hodEmployeeId String?          @unique @map("hod_employee_id") @db.Uuid
  hod           Employee?        @relation("DepartmentHod", fields: [hodEmployeeId], references: [id], onDelete: SetNull)
  employees     Employee[]       @relation("DepartmentEmployees")
  subjects      Subject[]
  timetable     TimetableEntry[]
  leaveRequests LeaveRequest[]
  circulars     Circular[]       @relation("DepartmentCirculars")
  onboardingCandidates OnboardingCandidate[]
  calendarDays  CalendarDay[]    @relation("DepartmentCalendarDays")
  leavePolicies LeavePolicy[]    @relation("DepartmentLeavePolicies")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@map("departments")
}

model Designation {
  id        Int                @id @default(autoincrement())
  name      String             @unique
  // Lower is more senior.
  level     Int
  category  StaffCategory
  employees Employee[]
  workload  WorkloadThreshold?
  onboardingCandidates OnboardingCandidate[]

  @@map("designations")
}

model Employee {
  id              String           @id @default(uuid()) @db.Uuid
  // College employee ID, stored uppercase, e.g. JCET-CSE-021.
  employeeCode    String           @unique @map("employee_code")
  firstName       String           @map("first_name")
  lastName        String           @map("last_name")
  // Stored lowercase.
  email           String           @unique
  phone           String?
  departmentId    Int              @map("department_id")
  department      Department       @relation("DepartmentEmployees", fields: [departmentId], references: [id], onDelete: Restrict)
  designationId   Int              @map("designation_id")
  designation     Designation      @relation(fields: [designationId], references: [id], onDelete: Restrict)
  employmentType  EmploymentType   @map("employment_type")
  joiningDate     DateTime         @map("joining_date") @db.Date
  status          EmployeeStatus   @default(ACTIVE)
  qualification   String?
  specialization  String?
  experienceYears Int?             @map("experience_years")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  user            User?
  headOf          Department?      @relation("DepartmentHod")
  timetable       TimetableEntry[]
  leaveRequests         LeaveRequest[]
  substitutions         Substitution[]
  attendance            Attendance[]
  attendanceCorrections AttendanceCorrection[]
  documents             Document[]
  examDuties            ExamDuty[]             @relation("ExamDutyFaculty")
  examDutySwapTarget    ExamDuty[]             @relation("ExamDutySwapTarget")
  workAssignedTo        WorkAssignment[]       @relation("WorkAssignedTo")
  onboardingRecord      OnboardingCandidate?   @relation("OnboardedCandidate")
  onDutyRequests        OnDutyRequest[]
  balanceAdjustments    LeaveBalanceAdjustment[] @relation("EmployeeBalanceAdjustments")

  @@index([departmentId])
  @@index([status])
  @@map("employees")
}

// Mandatory for employee and department changes (backend/SECURITY.md).
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  resource    String
  resourceId  String   @map("resource_id")
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([resource, resourceId])
  @@map("audit_logs")
}

// Timetable (features/TIMETABLE.md): fixed periods, Monday to Saturday.

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT

  @@map("weekday")
}

enum SubjectKind {
  THEORY
  LAB

  @@map("subject_kind")
}

enum RoomKind {
  CLASSROOM
  LAB

  @@map("room_kind")
}

model Period {
  // 1 = first period of the day.
  number    Int    @id
  // 24-hour "HH:MM".
  startTime String @map("start_time")
  endTime   String @map("end_time")

  @@map("periods")
}

model Subject {
  id           Int              @id @default(autoincrement())
  // VTU course code, stored uppercase, e.g. BCS501.
  code         String           @unique
  name         String
  departmentId Int              @map("department_id")
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  semester     Int
  kind         SubjectKind
  entries      TimetableEntry[]
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([departmentId, semester])
  @@map("subjects")
}

model Room {
  id      Int              @id @default(autoincrement())
  name    String           @unique
  kind       RoomKind
  entries    TimetableEntry[]
  examDuties ExamDuty[]

  @@map("rooms")
}

// One class: a section (or a lab batch of it) on a day, over one or more
// consecutive periods.
model TimetableEntry {
  id            String         @id @default(uuid()) @db.Uuid
  departmentId  Int            @map("department_id")
  department    Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  semester      Int
  // Class section, e.g. A.
  section       String
  // Lab batch within the section, e.g. A1; null for the whole section.
  batch         String?
  subjectId     Int            @map("subject_id")
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  facultyId     String         @map("faculty_id") @db.Uuid
  faculty       Employee       @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  roomId        Int            @map("room_id")
  room          Room           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  day           Weekday
  startPeriod   Int            @map("start_period")
  endPeriod     Int            @map("end_period")
  substitutions Substitution[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([departmentId, semester, section, day])
  @@index([facultyId, day])
  @@index([roomId, day])
  @@map("timetable_entries")
}

// Faculty workload (features/FACULTY_WORKLOAD.md). Weekly hours are computed
// from timetable entries; only the bands the Principal sets are stored.

// Weekly teaching-hour band for one teaching designation: below minHours is
// underloaded, above maxHours overloaded.
model WorkloadThreshold {
  designationId Int         @id @map("designation_id")
  designation   Designation @relation(fields: [designationId], references: [id], onDelete: Cascade)
  minHours      Int         @map("min_hours")
  maxHours      Int         @map("max_hours")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("workload_thresholds")
}

// Leave (features/LEAVE_MANAGEMENT.md). JCET's types, quotas, half-day and
// carry-over rules are data HR enters; the approval chain is fixed by role.
// Day counts are multiples of 0.5, which a float holds exactly.

model LeaveType {
  id              Int            @id @default(autoincrement())
  // Short code, stored uppercase, e.g. CL.
  code            String         @unique
  name            String         @unique
  // Days per calendar year; null means no limit (e.g. loss of pay).
  yearlyQuota     Float?         @map("yearly_quota")
  allowHalfDay    Boolean        @default(false) @map("allow_half_day")
  // Most unused days that move into the next year; 0 means none.
  carryForwardMax Float          @default(0) @map("carry_forward_max")
  // Retired types stay for history but take no new requests.
  active          Boolean        @default(true)
  requests        LeaveRequest[]
  policies        LeavePolicy[]  @relation("LeaveTypePolicies")
  adjustments     LeaveBalanceAdjustment[] @relation("LeaveTypeAdjustments")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@map("leave_types")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("leave_status")
}

enum HalfDaySession {
  FIRST
  SECOND

  @@map("half_day_session")
}

model LeaveRequest {
  id            String          @id @default(uuid()) @db.Uuid
  employeeId    String          @map("employee_id") @db.Uuid
  employee      Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  // The applicant's department when they applied; scopes HOD access.
  departmentId  Int             @map("department_id")
  department    Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  leaveTypeId   Int             @map("leave_type_id")
  leaveType     LeaveType       @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  startDate     DateTime        @map("start_date") @db.Date
  endDate       DateTime        @map("end_date") @db.Date
  // Set for a half-day request (one date only).
  halfDay       HalfDaySession? @map("half_day")
  // Working days taken (Sundays excluded).
  days          Float
  reason        String
  status        LeaveStatus     @default(PENDING)
  // Approver roles in order, fixed when the request is made.
  approverRoles String[]        @map("approver_roles")
  // Role that acts next; null once the request is decided or cancelled.
  pendingRole   String?         @map("pending_role")
  policyId      String?         @map("policy_id") @db.Uuid
  policy        LeavePolicy?    @relation(fields: [policyId], references: [id], onDelete: SetNull)
  dutyType      String?         @map("duty_type")
  organisation  String?
  location      String?
  referenceNumber String?       @map("reference_number")
  attachmentName String?        @map("attachment_name")
  attachmentUrl String?         @map("attachment_url")
  restrictedHolidayId String?   @map("restricted_holiday_id")
  vacationPeriodId String?      @map("vacation_period_id")
  coverageRequired Boolean      @default(true) @map("coverage_required")
  operationalCoverageRole String? @map("operational_coverage_role")
  operationalCoverageNote String? @map("operational_coverage_note")
  decisions     LeaveDecision[]
  substitutions Substitution[]
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([employeeId, startDate])
  @@index([status, pendingRole, departmentId])
  @@map("leave_requests")
}

// One approval or rejection, step by step.
model LeaveDecision {
  id            String       @id @default(uuid()) @db.Uuid
  requestId     String       @map("request_id") @db.Uuid
  request       LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  step          Int
  role          String
  deciderUserId String       @map("decider_user_id") @db.Uuid
  decider       User         @relation(fields: [deciderUserId], references: [id], onDelete: Restrict)
  approved      Boolean
  note          String?
  decidedAt     DateTime     @default(now()) @map("decided_at")

  @@index([requestId])
  @@map("leave_decisions")
}

// Smart substitution (features/SMART_SUBSTITUTION.md): how each class missed
// through approved leave is covered, one row per class and date.

enum CoverageKind {
  // Another faculty member takes the class.
  SUBSTITUTE
  // Handled without a substitute (e.g. supervised self-study); see note.
  NOT_NEEDED

  @@map("coverage_kind")
}

model Substitution {
  id               String         @id @default(uuid()) @db.Uuid
  leaveRequestId   String         @map("leave_request_id") @db.Uuid
  leaveRequest     LeaveRequest   @relation(fields: [leaveRequestId], references: [id], onDelete: Restrict)
  // ponytail: a deleted class takes its coverage with it; keep a snapshot
  // of the class if past coverage must survive timetable changes.
  timetableEntryId String         @map("timetable_entry_id") @db.Uuid
  timetableEntry   TimetableEntry @relation(fields: [timetableEntryId], references: [id], onDelete: Cascade)
  date             DateTime       @db.Date
  kind             CoverageKind
  substituteId     String?        @map("substitute_id") @db.Uuid
  substitute       Employee?      @relation(fields: [substituteId], references: [id], onDelete: Restrict)
  // The arrangement when no substitute is needed.
  note             String?
  assignedByUserId String         @map("assigned_by_user_id") @db.Uuid
  assignedBy       User           @relation(fields: [assignedByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now()) @map("created_at")

  @@unique([timetableEntryId, date])
  @@index([substituteId, date])
  @@index([leaveRequestId])
  @@map("substitutions")
}

// In-app notifications (features/NOTIFICATIONS.md), one row per recipient.
model Notification {
  pushDeliveries PushDelivery[]
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // What happened, e.g. leave.submitted; lets clients pick an icon.
  kind      String
  title     String
  body      String
  // In-app path to open, e.g. /leave?request=…
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

// Attendance (features/ATTENDANCE.md, tasks/team/ZEESHAN_MADRAS.md).

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  LATE
  ON_DUTY

  @@map("attendance_status")
}

enum AttendanceSource {
  WEB
  MOBILE
  BIOMETRIC
  MANUAL

  @@map("attendance_source")
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("correction_status")
}

model Attendance {
  id          String                 @id @default(uuid()) @db.Uuid
  employeeId  String                 @map("employee_id") @db.Uuid
  employee    Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  date        DateTime               @db.Date
  checkIn     DateTime?              @map("check_in")
  checkOut    DateTime?              @map("check_out")
  status      AttendanceStatus       @default(PRESENT)
  source      AttendanceSource       @default(WEB)
  notes       String?
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  corrections AttendanceCorrection[]

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId, date])
  @@map("attendance")
}

model AttendanceCorrection {
  id                String           @id @default(uuid()) @db.Uuid
  attendanceId      String?          @map("attendance_id") @db.Uuid
  attendance        Attendance?      @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employeeId        String           @map("employee_id") @db.Uuid
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  date              DateTime         @db.Date
  requestedCheckIn  DateTime?        @map("requested_check_in")
  requestedCheckOut DateTime?        @map("requested_check_out")
  requestedStatus   AttendanceStatus @default(PRESENT) @map("requested_status")
  reason            String
  status            CorrectionStatus @default(PENDING)
  reviewedByUserId  String?          @map("reviewed_by_user_id") @db.Uuid
  reviewedByUser    User?            @relation("AttendanceReviewed", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?        @map("reviewed_at")
  reviewNote        String?          @map("review_note")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([employeeId, date])
  @@index([status])
  @@map("attendance_corrections")
}

model AttendanceSettings {
  id                 Int      @id @default(autoincrement())
  workDayStart       String   @default("09:00") @map("work_day_start")
  workDayEnd         String   @default("17:00") @map("work_day_end")
  gracePeriodMinutes Int      @default(15) @map("grace_period_minutes")
  halfDayHours       Float    @default(4.0) @map("half_day_hours")
  fullDayHours       Float    @default(7.0) @map("full_day_hours")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("attendance_settings")
}

// Digital Document Management (features/DOCUMENTS.md, tasks/team/ZEESHAN_MADRAS.md).

enum DocumentCategory {
  IDENTITY
  ACADEMIC
  EMPLOYMENT
  CERTIFICATION
  OTHER

  @@map("document_category")
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("document_status")
}

model Document {
  id               String           @id @default(uuid()) @db.Uuid
  employeeId       String           @map("employee_id") @db.Uuid
  employee         Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category         DocumentCategory
  title            String
  documentType     String           @map("document_type")
  fileUrl          String           @map("file_url")
  fileName         String           @map("file_name")
  fileSize         Int              @map("file_size")
  mimeType         String           @map("mime_type")
  status           DocumentStatus   @default(PENDING)
  expiryDate       DateTime?        @map("expiry_date") @db.Date
  reviewedByUserId String?          @map("reviewed_by_user_id") @db.Uuid
  reviewedByUser   User?            @relation("DocumentReviewed", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?        @map("reviewed_at")
  reviewNote       String?          @map("review_note")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([employeeId])
  @@index([status])
  @@index([category])
  @@map("documents")
}




model PushDevice {
  id        String @id @default(uuid()) @db.Uuid
  token     String @unique @db.VarChar(256)
  userId    String @map("user_id") @db.Uuid
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String @unique @map("session_id") @db.Uuid
  session   RefreshSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  platform  String @db.VarChar(7)
  projectId String @map("project_id") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  deliveries PushDelivery[]
  @@index([userId])
  @@map("push_devices")
}

model PushDelivery {
  id             String @id @default(uuid()) @db.Uuid
  notificationId String @map("notification_id") @db.Uuid
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  deviceId       String @map("device_id") @db.Uuid
  device         PushDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  attempts       Int @default(0)
  nextAttemptAt  DateTime @default(now()) @map("next_attempt_at")
  ticketId       String? @map("ticket_id")
  createdAt      DateTime @default(now()) @map("created_at")
  @@unique([notificationId, deviceId])
  @@index([nextAttemptAt])
  @@map("push_deliveries")
}

// One-use recovery challenges. OTP mail is encrypted until delivery, never plaintext.
model PasswordResetChallenge {
  id               String    @id @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  user             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountKey       String    @map("account_key")
  otpHash          String    @map("otp_hash")
  passwordStamp    String?   @map("password_stamp")
  expiresAt        DateTime  @map("expires_at")
  consumedAt       DateTime? @map("consumed_at")
  attempts         Int       @default(0)
  encryptedMail    String?   @map("encrypted_mail")
  deliveryAttempts Int       @default(0) @map("delivery_attempts")
  nextDeliveryAt   DateTime  @default(now()) @map("next_delivery_at")
  leaseUntil       DateTime? @map("lease_until")
  deliveredAt      DateTime? @map("delivered_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([accountKey, createdAt])
  @@index([nextDeliveryAt])
  @@map("password_reset_challenges")
}

model PasswordResetThrottle {
  key          String   @id
  startedAt    DateTime @map("started_at")
  lastAttempt  DateTime @map("last_attempt")
  count        Int      @default(0)

  @@map("password_reset_throttles")
}

// ----------------------------------------------------
// Exam Duty & Invigilation Allotment Module
// ----------------------------------------------------

enum ExamType {
  VTU_SEMESTER
  INTERNAL_ASSESSMENT
  LAB_EXAM
}

enum ExamSessionStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ExamDutySession {
  MORNING
  AFTERNOON
}

enum ExamDutyRole {
  CHIEF_SUPERINTENDENT
  DEPUTY_CHIEF
  INVIGILATOR
  RELIEVER
  SQUAD
}

enum ExamDutyStatus {
  ASSIGNED
  CONFIRMED
  SWAP_REQUESTED
  SWAPPED
  ABSENT
  COMPLETED
}

enum ExamDutySwapStatus {
  PENDING
  APPROVED
  REJECTED
}

model ExamSession {
  id           String            @id @default(uuid()) @db.Uuid
  name         String
  academicYear String            @map("academic_year")
  examType     ExamType          @default(VTU_SEMESTER) @map("exam_type")
  startDate    DateTime          @map("start_date") @db.Date
  endDate      DateTime          @map("end_date") @db.Date
  status       ExamSessionStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  duties       ExamDuty[]

  @@map("exam_sessions")
}

model ExamDuty {
  id                String              @id @default(uuid()) @db.Uuid
  sessionId         String              @map("session_id") @db.Uuid
  session           ExamSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  date              DateTime            @db.Date
  sessionTime       ExamDutySession     @default(MORNING) @map("session_time")
  reportingTime     String              @default("09:00 AM") @map("reporting_time")
  roomId            Int?                @map("room_id")
  room              Room?               @relation(fields: [roomId], references: [id], onDelete: SetNull)
  facultyId         String              @map("faculty_id") @db.Uuid
  faculty           Employee            @relation("ExamDutyFaculty", fields: [facultyId], references: [id], onDelete: Restrict)
  role              ExamDutyRole        @default(INVIGILATOR)
  status            ExamDutyStatus      @default(ASSIGNED)
  swapWithFacultyId String?             @map("swap_with_faculty_id") @db.Uuid
  swapWithFaculty   Employee?           @relation("ExamDutySwapTarget", fields: [swapWithFacultyId], references: [id], onDelete: SetNull)
  swapReason        String?             @map("swap_reason")
  swapStatus        ExamDutySwapStatus? @map("swap_status")
  remarks           String?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@unique([facultyId, date, sessionTime])
  @@index([sessionId])
  @@index([date])
  @@index([facultyId])
  @@map("exam_duties")
}

// ----------------------------------------------------
// Digital Circulars & Institutional Notice Board Module
// ----------------------------------------------------

enum CircularCategory {
  ACADEMIC
  ADMINISTRATIVE
  HOLIDAY
  VTU_NOTIFICATION
  EXAMINATION
  EVENT
  URGENT
}

enum CircularPriority {
  NORMAL
  HIGH
  URGENT
}

enum CircularAudience {
  ALL
  TEACHING_ONLY
  NON_TEACHING_ONLY
  DEPARTMENT
}

model Circular {
  id                 String                @id @default(uuid()) @db.Uuid
  circularNumber     String                @unique @map("circular_number")
  title              String
  content            String                @db.Text
  category           CircularCategory      @default(ADMINISTRATIVE)
  priority           CircularPriority      @default(NORMAL)
  targetAudience     CircularAudience      @default(ALL) @map("target_audience")
  targetDepartmentId Int?                  @map("target_department_id")
  targetDepartment   Department?           @relation("DepartmentCirculars", fields: [targetDepartmentId], references: [id], onDelete: SetNull)
  attachmentUrl      String?               @map("attachment_url")
  attachmentName     String?               @map("attachment_name")
  isPublished        Boolean               @default(true) @map("is_published")
  publishedAt        DateTime              @default(now()) @map("published_at")
  expiresAt          DateTime?             @map("expires_at")
  createdById        String                @map("created_by_id") @db.Uuid
  createdBy          User                  @relation("CircularAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  receipts           CircularReadReceipt[]

  @@index([publishedAt])
  @@index([category])
  @@index([targetAudience])
  @@map("circulars")
}

model CircularReadReceipt {
  id         String   @id @default(uuid()) @db.Uuid
  circularId String   @map("circular_id") @db.Uuid
  circular   Circular @relation(fields: [circularId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt     DateTime @default(now()) @map("read_at")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")

  @@unique([circularId, userId])
  @@index([circularId])
  @@index([userId])
  @@map("circular_read_receipts")
}

// ----------------------------------------------------
// Official Task & Work Delegation Module
// ----------------------------------------------------

enum WorkPriority {
  NORMAL
  HIGH
  URGENT
}

enum WorkStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  CANCELLED
}

enum WorkCategory {
  ACADEMIC
  NBA_NAAC
  EXAMINATION
  STUDENT_AFFAIR
  EVENT
  ADMINISTRATIVE
  OTHER
}

model WorkAssignment {
  id                      String        @id @default(uuid()) @db.Uuid
  title                   String
  description             String        @db.Text
  category                WorkCategory  @default(ADMINISTRATIVE)
  priority                WorkPriority  @default(NORMAL)
  status                  WorkStatus    @default(ASSIGNED)
  assignedById            String        @map("assigned_by_id") @db.Uuid
  assignedBy              User          @relation("WorkAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  assignedToId            String        @map("assigned_to_id") @db.Uuid
  assignedTo              Employee      @relation("WorkAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)
  dueDate                 DateTime      @map("due_date")
  attachmentUrl           String?       @map("attachment_url")
  attachmentName          String?       @map("attachment_name")
  submissionNotes         String?       @map("submission_notes") @db.Text
  submissionAttachmentUrl String?       @map("submission_attachment_url")
  submittedAt             DateTime?     @map("submitted_at")
  reviewedAt              DateTime?     @map("reviewed_at")
  reviewFeedback          String?       @map("review_feedback")
  completedAt             DateTime?     @map("completed_at")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  @@index([assignedToId])
  @@index([assignedById])
  @@index([dueDate])
  @@index([status])
  @@index([priority])
  @@map("work_assignments")
}

// ----------------------------------------------------
// Recruitment & Onboarding Module
// ----------------------------------------------------

enum CandidateStatus {
  OFFER_PENDING
  OFFER_ISSUED
  OFFER_ACCEPTED
  DOCUMENTS_SUBMITTED
  ONBOARDED
  REJECTED
  WITHDRAWN

  @@map("candidate_status")
}

model OnboardingCandidate {
  id                  String          @id @default(uuid()) @db.Uuid
  appointmentRefNo    String          @unique @map("appointment_ref_no")
  firstName           String          @map("first_name")
  lastName            String          @map("last_name")
  email               String          @unique
  phone               String
  departmentId        Int             @map("department_id")
  department          Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designationId       Int             @map("designation_id")
  designation         Designation     @relation(fields: [designationId], references: [id], onDelete: Restrict)
  employmentType      EmploymentType  @map("employment_type")
  qualification       String
  specialization      String?
  experienceYears     Int             @default(0) @map("experience_years")
  expectedJoiningDate DateTime        @map("expected_joining_date") @db.Date
  status              CandidateStatus @default(OFFER_PENDING)

  // Salary & compensation structure
  payScale            String          @map("pay_scale")
  basicPay            Float           @map("basic_pay")
  agp                 Float           @default(0)
  daPercent           Float           @default(50) @map("da_percent")
  hraPercent          Float           @default(18) @map("hra_percent")
  grossSalary         Float           @map("gross_salary")
  probationMonths     Int             @default(12) @map("probation_months")
  noticePeriodMonths  Int             @default(3) @map("notice_period_months")

  // Documents checklist (JSON object)
  documentsChecklist  Json?           @map("documents_checklist")

  // When onboarded: links to created Employee
  employeeId          String?         @unique @map("employee_id") @db.Uuid
  employee            Employee?       @relation("OnboardedCandidate", fields: [employeeId], references: [id], onDelete: SetNull)

  // Appointment letter generation metadata
  issuedById          String?         @map("issued_by_id") @db.Uuid
  issuedBy            User?           @relation("AppointmentLetterIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedAt            DateTime?       @map("issued_at")
  joinedAt            DateTime?       @map("joined_at")
  notes               String?         @db.Text

  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  @@index([departmentId])
  @@index([designationId])
  @@index([status])
  @@index([appointmentRefNo])
  @@map("onboarding_candidates")
}

// ----------------------------------------------------
// Official On-Duty (OD) & Valuation Management Module
// ----------------------------------------------------

enum OnDutyCategory {
  UNIVERSITY_VALUATION
  EXTERNAL_EXAMINER
  CONFERENCE_SEMINAR
  FDP_WORKSHOP
  BOS_BOE_MEETING
  OFFICIAL_COLLEGE_DUTY
  OTHER

  @@map("on_duty_category")
}

enum OnDutyStatus {
  PENDING
  RECOMMENDED
  APPROVED
  REJECTED
  CANCELLED

  @@map("on_duty_status")
}

model OnDutyRequest {
  id                       String         @id @default(uuid()) @db.Uuid
  employeeId               String         @map("employee_id") @db.Uuid
  employee                 Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  category                 OnDutyCategory @default(UNIVERSITY_VALUATION)
  title                    String
  description              String         @db.Text
  venue                    String
  startDate                DateTime       @map("start_date") @db.Date
  endDate                  DateTime       @map("end_date") @db.Date
  totalDays                Float          @map("total_days")
  status                   OnDutyStatus   @default(PENDING)
  attachmentUrl            String?        @map("attachment_url")
  attachmentName           String?        @map("attachment_name")
  attendanceCertificateUrl String?        @map("attendance_certificate_url")

  // HOD review / recommendation
  hodReviewedById          String?        @map("hod_reviewed_by_id") @db.Uuid
  hodReviewedBy            User?          @relation("OnDutyHodReview", fields: [hodReviewedById], references: [id], onDelete: SetNull)
  hodReviewedAt            DateTime?      @map("hod_reviewed_at")
  hodNote                  String?        @map("hod_note")

  // Principal / Executive final approval
  finalApprovedById        String?        @map("final_approved_by_id") @db.Uuid
  finalApprovedBy          User?          @relation("OnDutyFinalApproval", fields: [finalApprovedById], references: [id], onDelete: SetNull)
  finalApprovedAt          DateTime?      @map("final_approved_at")
  finalNote                String?        @map("final_note")

  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")

  @@index([employeeId, startDate])
  @@index([status])
  @@index([category])
  @@map("on_duty_requests")
}

// ----------------------------------------------------
// Academic Calendar & Holiday Master Module
// ----------------------------------------------------

enum SemesterType {
  ODD
  EVEN

  @@map("semester_type")
}

enum CalendarDayType {
  WORKING_DAY
  WEEKLY_OFF
  PUBLIC_HOLIDAY
  RESTRICTED_HOLIDAY
  VACATION
  EXAMINATION
  INSTITUTIONAL_EVENT
  ACADEMIC_EVENT
  SPECIAL_WORKING_DAY

  @@map("calendar_day_type")
}

model AcademicYear {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @unique
  startDate    DateTime      @map("start_date") @db.Date
  endDate      DateTime      @map("end_date") @db.Date
  isCurrent    Boolean       @default(false) @map("is_current")
  status       String        @default("ACTIVE")
  semesters    Semester[]
  calendarDays CalendarDay[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([isCurrent])
  @@map("academic_years")
}

model Semester {
  id                String          @id @default(uuid()) @db.Uuid
  academicYearId    String          @map("academic_year_id") @db.Uuid
  academicYear      AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name              String
  type              SemesterType    @default(ODD)
  startDate         DateTime        @map("start_date") @db.Date
  endDate           DateTime        @map("end_date") @db.Date
  teachingStartDate DateTime?       @map("teaching_start_date") @db.Date
  teachingEndDate   DateTime?       @map("teaching_end_date") @db.Date
  examStartDate     DateTime?       @map("exam_start_date") @db.Date
  examEndDate       DateTime?       @map("exam_end_date") @db.Date
  isCurrent         Boolean         @default(false) @map("is_current")
  status            String          @default("ACTIVE")
  calendarDays      CalendarDay[]
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([academicYearId])
  @@index([isCurrent])
  @@map("semesters")
}

model CalendarDay {
  id                    String             @id @default(uuid()) @db.Uuid
  date                  DateTime           @map("date") @db.Date
  academicYearId        String             @map("academic_year_id") @db.Uuid
  academicYear          AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  semesterId            String?            @map("semester_id") @db.Uuid
  semester              Semester?          @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  dayType               CalendarDayType    @map("day_type")
  title                 String?
  description           String?            @db.Text
  isWorkingDay          Boolean            @map("is_working_day")
  departmentId          Int?               @map("department_id")
  department            Department?        @relation("DepartmentCalendarDays", fields: [departmentId], references: [id], onDelete: SetNull)
  appliesToEmployeeType String?            @map("applies_to_employee_type")
  source                String?            @default("MANUAL")
  createdById           String?            @map("created_by_id") @db.Uuid
  createdBy             User?              @relation("CalendarDayCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  restrictedHoliday     RestrictedHoliday?
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  @@index([date])
  @@index([academicYearId])
  @@index([semesterId])
  @@index([dayType])
  @@index([departmentId])
  @@map("calendar_days")
}

model RestrictedHoliday {
  id                    String       @id @default(uuid()) @db.Uuid
  calendarDayId         String?      @unique @map("calendar_day_id") @db.Uuid
  calendarDay           CalendarDay? @relation(fields: [calendarDayId], references: [id], onDelete: SetNull)
  name                  String
  date                  DateTime     @map("date") @db.Date
  active                Boolean      @default(true)
  annualYear            String       @map("annual_year")
  eligibleEmployeeTypes String?      @default("ALL") @map("eligible_employee_types")
  description           String?      @db.Text
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  @@index([date])
  @@index([annualYear])
  @@index([active])
  @@map("restricted_holidays")
}

model WeeklyWorkingPattern {
  id           String   @id @default(uuid()) @db.Uuid
  dayOfWeek    Int      @unique @map("day_of_week")
  dayName      String   @map("day_name")
  isWorkingDay Boolean  @default(true) @map("is_working_day")
  description  String?  @db.Text
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("weekly_working_patterns")
}

// Configurable Leave Policy Engine
enum LeaveAdjustmentType {
  CREDIT
  DEBIT
  OPENING_CORRECTION
  CARRY_FORWARD_CORRECTION
  LAPSE

  @@map("leave_adjustment_type")
}

model LeavePolicy {
  id                          String                  @id @default(uuid()) @db.Uuid
  code                        String                  // CL, EL, SPL_ML, OOD, ODE, RH, VL
  name                        String
  description                 String?                 @db.Text
  policyYear                  String                  @map("policy_year") // e.g. "2026", "2026-27"
  employeeCategory            StaffCategory           @map("employee_category") // TEACHING | NON_TEACHING
  appliesToAllCategories      Boolean                 @default(false) @map("applies_to_all_categories")
  employmentType              EmploymentType?         @map("employment_type") // null = ALL
  departmentId                Int?                    @map("department_id")
  department                  Department?             @relation("DepartmentLeavePolicies", fields: [departmentId], references: [id], onDelete: SetNull)
  leaveTypeId                 Int?                    @map("leave_type_id")
  leaveType                   LeaveType?              @relation("LeaveTypePolicies", fields: [leaveTypeId], references: [id], onDelete: SetNull)
  annualEntitlement           Float?                  @map("annual_entitlement") // null = "As per policy" / unfixed
  entitlementUnit             String                  @default("DAYS") @map("entitlement_unit")
  carryForwardAllowed         Boolean                 @default(false) @map("carry_forward_allowed")
  carryForwardLimit           Float                   @default(0) @map("carry_forward_limit")
  carryForwardExpiryMonths    Int?                    @map("carry_forward_expiry_months")
  lapseAtYearEnd              Boolean                 @default(true) @map("lapse_at_year_end")
  halfDayAllowed              Boolean                 @default(false) @map("half_day_allowed")
  minimumNoticeDays           Int                     @default(0) @map("minimum_notice_days")
  maximumConsecutiveDays      Int?                    @map("maximum_consecutive_days")
  minimumServiceDays          Int?                    @map("minimum_service_days")
  attachmentRequired          Boolean                 @default(false) @map("attachment_required")
  attachmentRequiredAfterDays Float?                  @map("attachment_required_after_days")
  reasonRequired              Boolean                 @default(true) @map("reason_required")
  attendanceStatus            String                  @default("ON_LEAVE") @map("attendance_status")
  affectsTimetable            Boolean                 @default(true) @map("affects_timetable")
  requiresAcademicCoverage    Boolean                 @default(true) @map("requires_academic_coverage")
  requiresOperationalCoverage Boolean                 @default(false) @map("requires_operational_coverage")
  reservePendingBalance       Boolean                 @default(true) @map("reserve_pending_balance")
  approvalPolicyKey           String?                 @default("STANDARD") @map("approval_policy_key")
  calendarPolicyKey           String?                 @default("INSTITUTION_CALENDAR") @map("calendar_policy_key")
  active                      Boolean                 @default(true)
  effectiveFrom               DateTime                @map("effective_from") @db.Date
  effectiveTo                 DateTime?               @map("effective_to") @db.Date
  requests                    LeaveRequest[]
  adjustments                 LeaveBalanceAdjustment[]
  createdAt                   DateTime                @default(now()) @map("created_at")
  updatedAt                   DateTime                @updatedAt @map("updated_at")

  @@unique([code, policyYear, employeeCategory, departmentId])
  @@index([policyYear])
  @@index([employeeCategory])
  @@index([active])
  @@map("leave_policies")
}

model LeaveBalanceAdjustment {
  id              String              @id @default(uuid()) @db.Uuid
  employeeId      String              @map("employee_id") @db.Uuid
  employee        Employee            @relation("EmployeeBalanceAdjustments", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId     Int?                @map("leave_type_id")
  leaveType       LeaveType?          @relation("LeaveTypeAdjustments", fields: [leaveTypeId], references: [id], onDelete: SetNull)
  policyId        String?             @map("policy_id") @db.Uuid
  policy          LeavePolicy?        @relation(fields: [policyId], references: [id], onDelete: SetNull)
  leaveCode       String              @map("leave_code")
  policyYear      String              @map("policy_year")
  adjustmentType  LeaveAdjustmentType @map("adjustment_type")
  days            Float
  reason          String              @db.Text
  actorUserId     String              @map("actor_user_id") @db.Uuid
  actorUser       User                @relation("BalanceAdjuster", fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime            @default(now()) @map("created_at")

  @@index([employeeId, policyYear])
  @@index([leaveCode])
  @@map("leave_balance_adjustments")
}

model EmployeePolicyGroup {
  id               String        @id @default(uuid()) @db.Uuid
  name             String        @unique
  description      String?       @db.Text
  employeeCategory StaffCategory @map("employee_category")
  calendarPolicy   String?       @default("INSTITUTION_CALENDAR") @map("calendar_policy")
  attendancePolicy String?       @default("STANDARD") @map("attendance_policy")
  active           Boolean       @default(true)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@map("employee_policy_groups")
}

model OnDutyDutyMapping {
  id              String   @id @default(uuid()) @db.Uuid
  dutyCategory    String   @unique @map("duty_category")
  targetLeaveCode String   @map("target_leave_code")
  title           String
  description     String?  @db.Text
  active          Boolean  @default(true)
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("on_duty_duty_mappings")
}





