# Railway staging service only. Enter secrets in Railway, not this file.
APP_ENV=staging
NODE_ENV=production
VITE_API_URL=/api/v1
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Record these only after verifying the newly provisioned staging DB service.
STAGING_DATABASE_HOST=
STAGING_DATABASE_PORT=
STAGING_DATABASE_NAME=
JWT_ACCESS_SECRET=
CORS_ORIGIN=
DOCUMENTS_DIR=/data/documents
PUSH_ENABLED=false
# Railway supplies RAILWAY_ENVIRONMENT_NAME and RAILWAY_VOLUME_MOUNT_PATH.
# Create a new staging database and mount a separate private volume at /data.
# Add EXPO_PROJECT_ID only after the approved Expo project is linked.
