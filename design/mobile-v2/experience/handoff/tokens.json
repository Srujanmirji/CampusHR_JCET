{
  "meta": {
    "name": "CampusHR Mobile Design System V2",
    "version": "2.0.0",
    "date": "2026-10-23",
    "language": "Academic Clarity",
    "status": "Canonical design specification; not adopted by runtime",
    "authority": "DESIGN_SYSTEM.md",
    "units": "iOS logical points; Android density-independent layout and scalable text; sizes are minimums unless noted"
  },
  "color": {
    "canvas": "#F7F8FC",
    "surface": "#FFFFFF",
    "surfaceSecondary": "#F1F5F9",
    "ink": "#111827",
    "textSecondary": "#667085",
    "textTertiary": "#98A2B3",
    "divider": "#E5E7EB",
    "controlStroke": "#7A8699",
    "brandDeep": "#1E3A8A",
    "action": "#2563EB",
    "actionPressed": "#1D4ED8",
    "interactiveAccent": "#3B82F6",
    "onAction": "#FFFFFF",
    "brandAccent": "#F05023",
    "brandAccentInk": "#B9330F",
    "focus": "#2563EB",
    "blueContainer": "#EFF6FF",
    "violet": "#7C3AED",
    "violetContainer": "#F5F3FF",
    "mint": "#10B981",
    "mintInk": "#047857",
    "mintContainer": "#ECFDF5",
    "amber": "#F59E0B",
    "amberInk": "#92400E",
    "amberContainer": "#FFFBEB",
    "coral": "#F97360",
    "coralInk": "#B42318",
    "coralPressed": "#912018",
    "coralContainer": "#FFF1EE"
  },
  "domain": {
    "timetable": {
      "accent": "action",
      "ink": "action",
      "container": "blueContainer"
    },
    "attendance": {
      "accent": "mint",
      "ink": "mintInk",
      "container": "mintContainer"
    },
    "leave": {
      "accent": "violet",
      "ink": "violet",
      "container": "violetContainer"
    },
    "substitution": {
      "class": "action",
      "coveringFaculty": "violet",
      "gradient": false
    }
  },
  "feedback": {
    "success": {
      "accent": "mint",
      "ink": "mintInk",
      "container": "mintContainer"
    },
    "warning": {
      "accent": "amber",
      "ink": "amberInk",
      "container": "amberContainer"
    },
    "destructive": {
      "accent": "coral",
      "ink": "coralInk",
      "container": "coralContainer"
    },
    "neutral": {
      "ink": "textSecondary",
      "container": "surfaceSecondary"
    }
  },
  "font": {
    "ios": "System SF Pro with Dynamic Type",
    "android": "Inter with system font scaling",
    "specimen": "Inter",
    "fallback": "Platform system sans-serif",
    "minimumContentSize": 14,
    "allowFontScaling": true,
    "capDynamicType": false
  },
  "typography": {
    "largePageTitle": {
      "size": 32,
      "lineHeight": 38,
      "weight": 600
    },
    "navigationTitle": {
      "size": 18,
      "lineHeight": 24,
      "weight": 600
    },
    "greetingTitle": {
      "size": 26,
      "lineHeight": 32,
      "weight": 600
    },
    "sectionTitle": {
      "size": 20,
      "lineHeight": 26,
      "weight": 600
    },
    "body": {
      "size": 17,
      "lineHeight": 26,
      "weight": 400
    },
    "secondaryBody": {
      "size": 15,
      "lineHeight": 22,
      "weight": 400
    },
    "caption": {
      "size": 14,
      "lineHeight": 20,
      "weight": 400
    },
    "button": {
      "size": 16,
      "lineHeight": 22,
      "weight": 600
    },
    "tabLabel": {
      "size": 14,
      "lineHeight": 20,
      "weight": 500
    },
    "metricValue": {
      "size": 28,
      "lineHeight": 34,
      "weight": 600
    }
  },
  "space": {
    "4": 4,
    "8": 8,
    "12": 12,
    "16": 16,
    "20": 20,
    "24": 24,
    "32": 32,
    "40": 40,
    "48": 48
  },
  "radius": {
    "smallControl": 8,
    "button": 10,
    "field": 12,
    "card": 14,
    "sheetTop": 24,
    "status": 8,
    "avatar": "circle"
  },
  "stroke": {
    "divider": 1,
    "control": 1,
    "focus": 2,
    "focusOffset": 2,
    "timeline": 2
  },
  "size": {
    "touchTargetMin": 48,
    "buttonMinHeight": 48,
    "fieldMinHeight": 52,
    "searchMinHeight": 48,
    "segmentMinHeight": 48,
    "rowMinHeight": 56,
    "twoLineRowMinHeight": 76,
    "contextRowMinHeight": 96,
    "navigationBarMinHeight": 56,
    "tabBarMinHeight": 64,
    "icon": 24,
    "inlineIcon": 20,
    "feedbackIcon": 32,
    "avatarCompact": 32,
    "avatarRow": 40,
    "avatarProfile": 64,
    "scheduleRail": 64,
    "readableColumnMax": 680
  },
  "surface": {
    "defaultElevation": "none",
    "sheetElevation": "native",
    "scrimColor": "ink",
    "scrimOpacity": 0.32,
    "gradients": false,
    "blur": false
  },
  "button": {
    "primary": {
      "background": "action",
      "foreground": "onAction",
      "pressedBackground": "actionPressed"
    },
    "secondary": {
      "background": "surfaceSecondary",
      "foreground": "brandDeep",
      "pressedBackground": "divider"
    },
    "text": {
      "background": "transparent",
      "foreground": "action",
      "pressedBackground": "blueContainer"
    },
    "destructive": {
      "background": "coralInk",
      "foreground": "onAction",
      "pressedBackground": "coralPressed"
    },
    "destructiveText": {
      "background": "transparent",
      "foreground": "coralInk",
      "pressedBackground": "coralContainer"
    },
    "disabled": {
      "background": "surfaceSecondary",
      "foreground": "textSecondary",
      "opacity": 1
    },
    "busy": {
      "retainLabel": true,
      "preventDuplicateSubmission": true
    }
  },
  "navigation": {
    "faculty": ["Home", "Timetable", "Attendance", "Leave", "Profile"],
    "hod": ["Home", "Approvals", "Timetable", "Workload", "Profile"],
    "notifications": "top-right bell",
    "settings": "Profile row",
    "hodPersonalDestinations": ["My leave", "My attendance", "My documents"],
    "floatingSettings": false
  },
  "icons": {
    "ios": "SF Symbols; verify OS availability at implementation",
    "android": "Material Symbols Outlined",
    "androidAxes": {
      "FILL": 0,
      "selectedFILL": 1,
      "wght": 400,
      "GRAD": 0,
      "opsz": 24
    },
    "productionMixedFamilies": false
  },
  "components": [
    "navigationBar",
    "bottomTabBar",
    "button",
    "secondaryButton",
    "textButton",
    "textInput",
    "passwordInput",
    "search",
    "segmentedControl",
    "dateSelector",
    "toggle",
    "checkbox",
    "avatar",
    "statusLabel",
    "listRow",
    "scheduleRow",
    "timelineItem",
    "metric",
    "progress",
    "emptyState",
    "errorState",
    "skeleton",
    "bottomSheet",
    "confirmationSheet",
    "alert",
    "toast",
    "notificationRow",
    "profileRow",
    "leaveBalanceRow",
    "facultyRecommendationRow"
  ],
  "motion": {
    "implementation": "principles only; native behavior preferred",
    "pressMs": [80, 120],
    "selectionMs": [120, 180],
    "sheetSettleMs": [280, 360],
    "confirmedSuccessMs": [160, 220],
    "decorativeMotion": false,
    "skeletonShimmer": false,
    "reducedMotion": "No custom bounce, travel, counting or shimmer; preserve state and direct manipulation",
    "haptics": {
      "routineNavigation": "none",
      "meaningfulSelection": "light",
      "confirmedCommit": "medium",
      "importantDestructiveCommit": "native warning/strong; confirmation still required",
      "unknownOutcome": "no success feedback"
    }
  },
  "contrastPairs": [
    {
      "foreground": "ink",
      "background": "surface",
      "minimum": 4.5
    },
    {
      "foreground": "textSecondary",
      "background": "surface",
      "minimum": 4.5
    },
    {
      "foreground": "textSecondary",
      "background": "canvas",
      "minimum": 4.5
    },
    {
      "foreground": "textSecondary",
      "background": "surfaceSecondary",
      "minimum": 4.5
    },
    {
      "foreground": "onAction",
      "background": "action",
      "minimum": 4.5
    },
    {
      "foreground": "onAction",
      "background": "actionPressed",
      "minimum": 4.5
    },
    {
      "foreground": "action",
      "background": "blueContainer",
      "minimum": 4.5
    },
    {
      "foreground": "violet",
      "background": "violetContainer",
      "minimum": 4.5
    },
    {
      "foreground": "mintInk",
      "background": "mintContainer",
      "minimum": 4.5
    },
    {
      "foreground": "amberInk",
      "background": "amberContainer",
      "minimum": 4.5
    },
    {
      "foreground": "coralInk",
      "background": "coralContainer",
      "minimum": 4.5
    },
    {
      "foreground": "onAction",
      "background": "coralInk",
      "minimum": 4.5
    },
    {
      "foreground": "onAction",
      "background": "coralPressed",
      "minimum": 4.5
    },
    {
      "foreground": "controlStroke",
      "background": "surfaceSecondary",
      "minimum": 3
    },
    {
      "foreground": "focus",
      "background": "canvas",
      "minimum": 3
    }
  ],
  "restrictedPairs": [
    {
      "foreground": "textTertiary",
      "background": "surface",
      "reason": "Accent/decorative only; fails normal text contrast"
    },
    {
      "foreground": "interactiveAccent",
      "background": "surface",
      "reason": "Accent/decorative only; fails normal text contrast"
    },
    {
      "foreground": "mint",
      "background": "surface",
      "reason": "Accent/decorative only; fails normal text contrast"
    },
    {
      "foreground": "amber",
      "background": "surface",
      "reason": "Accent/decorative only; fails normal text contrast"
    },
    {
      "foreground": "coral",
      "background": "surface",
      "reason": "Accent/decorative only; fails normal text contrast"
    },
    {
      "foreground": "brandAccent",
      "background": "surface",
      "reason": "Accent/decorative only; fails normal text contrast"
    }
  ]
}
