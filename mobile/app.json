{
  "expo": {
    "name": "CampusHR",
    "slug": "campushr-jcet",
    "scheme": "campushr",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-notifications",
      "expo-secure-store"
    ]
  }
}
