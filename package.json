{
  "name": "campushr-jcet",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "frontend",
    "backend",
    "mobile"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @campushr/web",
    "dev:api": "npm run dev --workspace @campushr/api",
    "dev:mobile": "npm run dev --workspace @campushr/mobile",
    "build": "npm run build --workspace @campushr/web && npm run build --workspace @campushr/api",
    "start": "npm run db:deploy --workspace @campushr/api && npm run start --workspace @campushr/api",
    "staging:start": "node scripts/staging/preflight.mjs && npm start",
    "staging:check": "node --test scripts/staging/*.test.mjs",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspace @campushr/api",
    "db:validate": "npm run db:validate --workspace @campushr/api",
    "db:generate": "npm run db:generate --workspace @campushr/api",
    "db:migrate": "npm run db:migrate --workspace @campushr/api",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "format": "prettier --write package.json eslint.config.js compose.yaml 'frontend/*.{json,ts,html}' 'frontend/src/**/*.{ts,tsx,css}' 'backend/*.{json,ts}' 'backend/src/**/*.ts' 'backend/test/**/*.ts' 'mobile/*.{json,ts}' 'mobile/{app,lib}/**/*.{ts,tsx}'",
    "format:check": "prettier --check package.json eslint.config.js compose.yaml 'frontend/*.{json,ts,html}' 'frontend/src/**/*.{ts,tsx,css}' 'backend/*.{json,ts}' 'backend/src/**/*.ts' 'backend/test/**/*.ts' 'mobile/*.{json,ts}' 'mobile/{app,lib}/**/*.{ts,tsx}'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "prettier": "^3.8.0",
    "railway": "3.16.0",
    "typescript-eslint": "^8.57.0"
  },
  "type": "module"
}
